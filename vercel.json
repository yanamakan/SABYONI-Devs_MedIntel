{
  "version": 2,
  "installCommand": "cd BackEnd && npm install",
  "functions": {
    "BackEnd/api/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)",       "dest": "/BackEnd/api/$1" },
    { "src": "/Dashboard/(.*)", "dest": "/Dashboard/$1"   },
    { "src": "/Scripts/(.*)",   "dest": "/Scripts/$1"     },
    { "src": "/",               "dest": "/Dashboard/login.html" },
    { "src": "/(.*)",           "dest": "/$1"             }
  ]
}