{
  "version": 2,
  "installCommand": "cd BackEnd && npm install",
  "functions": {
    "BackEnd/api/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/BackEnd/api/:path*" },
    { "source": "/", "destination": "/Dashboard/login.html" },
    { "source": "/:path*", "destination": "/:path*" }
  ]
}